# Copy to deploy/.env.prod and fill in. Make every secret with:  openssl rand -hex 32
DOMAIN=example.com                 # api.<DOMAIN> and status.<DOMAIN> must point at this server
ACME_EMAIL=you@example.com

POSTGRES_USER=geocode_owner        # the database owner: migrations, the gazetteer build and the keys command use it
POSTGRES_PASSWORD=
POSTGRES_DB=geocode
APP_DB_PASSWORD=                   # password of the API's restricted login, geocode_app

HASH_KEY=                          # keyed hash of addresses in the request log; keep it stable
DEFAULT_RATE_PER_MIN=60
GRAFANA_ADMIN_PASSWORD=
PROBE_API_KEY=                     # create it after the first start (see DEPLOY.md), then bring the probe up

GO_VERSION=1.27.0                    # must match go.mod
POSTGIS_TAG=16-3.4                 # tested tag. With PostgreSQL 18 or newer the data volume path changes (see compose file)
PROMETHEUS_TAG=latest              # pin both after the first working deploy
GRAFANA_TAG=latest
