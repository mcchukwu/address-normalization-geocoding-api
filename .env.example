# Copy this file to .env and adjust values for your machine.
# Do not commit .env or real credentials to version control.

# -----------------------------------------------------------------------------
# PostgreSQL / Docker Compose
# These must match the PostgreSQL user's credentials and database.
# Changing POSTGRES_PASSWORD does not change an existing database volume's user.
# -----------------------------------------------------------------------------
POSTGRES_DB=dbname
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me-local-only

# Makefile database URL (used by `make run` if your run target uses $(DB_URL)).
# Keep this in sync with POSTGRES_DB, POSTGRES_USER, and POSTGRES_PASSWORD.
DB_URL=postgres://user:change-me-local-only@localhost:5432/dbname?sslmode=disable

# Go application's database connection (used by config.FromEnv directly).
# For Go running on your host, use localhost. Inside Docker Compose, use host `db`.
DATABASE_URL=postgres://user:change-me-local-only@localhost:5432/dbname?sslmode=disable

# -----------------------------------------------------------------------------
# HTTP service
# -----------------------------------------------------------------------------
GEOCODE_ENV=dev
ADDR=:8080
ADMIN_ADDR=127.0.0.1:9090

# -----------------------------------------------------------------------------
# Authentication: local development only
# AUTH_STATIC_KEYS format: key|tenant-uuid|tenant-name|comma-separated-scopes
# Send only `devkey` in the X-API-Key request header, not the full pipe-delimited
# AUTH_STATIC_KEYS value.
# -----------------------------------------------------------------------------
AUTH_MODE=static
AUTH_STATIC_KEYS='devkey|11111111-1111-4111-8111-111111111111|Dev Tenant|geocode,normalize,corrections:write'
# Only needed when AUTH_MODE=http:
# AUTH_URL=http://localhost:8081/introspect

# -----------------------------------------------------------------------------
# Resolver and request limits
# `fixture` provides approximate demo data and is development-only.
# -----------------------------------------------------------------------------
SOURCES=fixture
SOURCE_TIMEOUT_MS=800
DEFAULT_RATE_PER_MIN=60
MAX_BODY_BYTES=131072

# -----------------------------------------------------------------------------
# Metadata / hashing
# In development HASH_KEY can be omitted; config generates a random key at start.
# Set a stable secret of at least 16 characters in production.
# -----------------------------------------------------------------------------
DATA_VERSION=dev
# HASH_KEY=replace-with-a-stable-secret-of-at-least-16-characters
